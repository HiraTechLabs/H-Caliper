# Copy to .env, generate secrets, and never commit the resulting file.
ENV=production
APP_NAME=H-Caliper
API_PREFIX=/api/v1

# Required production secrets. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# Initial account is created through the web setup page; no default password.
BOOTSTRAP_ADMIN_EMAIL=

POSTGRES_DB=hcaliper
POSTGRES_USER=hcaliper
# Use URL-safe hex, e.g. python -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
POSTGRES_PORT=5433
BACKEND_PORT=8001
HTTP_PORT=8080
COOKIE_SECURE=true
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:8080
TRUSTED_PROXY_COUNT=1

WORKER_ID=worker-1
WORKER_POLL_SECONDS=2
WORKER_LOCK_STALE_MINUTES=90
MAX_RETRIES_DEFAULT=2
KEEP_TASK_WORKSPACES=true
ALLOW_PRODUCTION_DEPLOYMENT=false

# Only needed when local repository paths are intentionally permitted.
ALLOWED_LOCAL_REPO_ROOTS=
# Provider private network endpoint support. Keep local/private access scoped
# to trusted network policy; outbound provider hosts should be reviewed.
ALLOW_PRIVATE_PROVIDER_HOSTS=true
PROVIDER_CONNECT_TIMEOUT=10
PROVIDER_REQUEST_TIMEOUT=300
AGENT_TIMEOUT_SECONDS=1800
COMMAND_TIMEOUT_SECONDS=1200
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_RETENTION_DAYS=365
